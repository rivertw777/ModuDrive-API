# Copy to .env and fill in real values for local dev.

# Postgres admin (infra only — services never use it)
POSTGRES_USER=modudrive
POSTGRES_PASSWORD=changeme
# One database + login per service (member_db/member_service, file_db/file_service,
# notification_db/notification_service), created on an empty volume by .docker/init/
MEMBER_DB_PASSWORD=changeme
FILE_DB_PASSWORD=changeme
NOTIFICATION_DB_PASSWORD=changeme

# Redis (infra + auth-service, member-service)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# LocalStack (local SQS + S3). Free non-commercial token: app.localstack.cloud → Auth Tokens.
# Also read by ./gradlew test (the SQS module's queue test) — export it in your shell profile too.
LOCALSTACK_AUTH_TOKEN=changeme

# SQS (LocalStack locally; on AWS leave the endpoint/keys unset so the ECS task role applies)
# Used by member/file-service (outbox producers) and file/mail/notification-service (consumers).
SQS_ENDPOINT=http://localstack:4566
SQS_REGION=ap-northeast-2
SQS_ACCESS_KEY=test
SQS_SECRET_KEY=test

# S3 (LocalStack locally, storage-service; LocalStack accepts any keys. On AWS leave the endpoint/keys
# unset so the ECS task role applies)
STORAGE_S3_ENDPOINT=http://localstack:4566
STORAGE_S3_ACCESS_KEY=test
STORAGE_S3_SECRET_KEY=test
STORAGE_S3_BUCKET=modudrive
STORAGE_S3_REGION=us-east-1

# observability (Grafana admin login — anonymous viewer access is separate)
GRAFANA_ADMIN_PASSWORD=changeme
# 이벤트 전송 알림(outbox)을 받는 디스코드 웹후크 (채널 설정 → 연동 → 웹후크 → URL 복사).
# 안 넣으면 알림 규칙은 그대로 돌고 전송만 실패한다 — .docs/spec/discord-alert-spec.md 7장.
DISCORD_MESSAGING_WEBHOOK_URL=https://discord.com/api/webhooks/changeme
# 서비스 상태 알림(응답 없음 등)을 받는 두 번째 채널의 웹후크. 안 넣으면 그 알림만 전송에 실패한다.
DISCORD_SERVICE_WEBHOOK_URL=https://discord.com/api/webhooks/changeme

# Shared service config
SPRING_PROFILES_ACTIVE=dev
# Service-to-service secret for the /internal/** routes — must be identical everywhere.
# Verified by: file-service, storage-service, member-service (each guards its own /internal/**).
# Presented by: storage-service, member-service, file-service, auth-service (each calls another
# service's /internal/** and attaches this as X-Internal-Token). Several services do both.
INTERNAL_SERVICE_TOKEN=changeme

# Service ports
GATEWAY_SERVER_PORT=10001
MEMBER_SERVER_PORT=10010
AUTH_SERVER_PORT=10011
FILE_SERVER_PORT=10012
STORAGE_SERVER_PORT=10013
MAIL_SERVER_PORT=10014
NOTIFICATION_SERVER_PORT=10015

# gateway-service
CLIENT_URL=http://localhost:3000

# auth-service
JWT_SECRET_KEY=changeme
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_REFRESH_TOKEN_COOKIE_SECURE=false

# file-service
MODUDRIVE_FILE_DEFAULT_QUOTA_BYTES=21474836480

# storage-service
STORAGE_MULTIPART_MAX_FILE_SIZE=25MB
STORAGE_MULTIPART_MAX_REQUEST_SIZE=25MB
MODUDRIVE_STORAGE_MAX_FILE_SIZE_BYTES=5368709120
STORAGE_BLOCK_SIZE=4194304
STORAGE_ENCRYPTION_KEY=changeme
# Per-file download volume per window before that file locks (0 or negative = disabled)
STORAGE_DOWNLOAD_QUOTA_PER_FILE_BYTES=10737418240
STORAGE_DOWNLOAD_QUOTA_WINDOW=PT24H

# member-service
MEMBER_EMAIL_VERIFICATION_TOKEN_EXPIRATION=180000

# mail-service (mail sending)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=changeme
MAIL_PASSWORD=changeme
MAIL_FROM=noreply@modudrive.com
