# Copy to .env and fill in real values for local dev.

# Postgres (infra + services)
POSTGRES_DB=modu_drive
POSTGRES_USER=modudrive
POSTGRES_PASSWORD=changeme
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/${POSTGRES_DB}
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Redis (infra + auth-service, member-service)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# Kafka (infra + member/file/mail-service)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# MinIO (infra + storage-service)
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_BUCKET=modudrive
STORAGE_S3_REGION=us-east-1

# Shared service config
SPRING_PROFILES_ACTIVE=dev

# Service ports
EUREKA_SERVER_PORT=10000
GATEWAY_SERVER_PORT=10001
MEMBER_SERVER_PORT=10010
AUTH_SERVER_PORT=10011
FILE_SERVER_PORT=10012
STORAGE_SERVER_PORT=10013
MAIL_SERVER_PORT=10014

# gateway-service
CLIENT_URL=http://localhost:3000

# auth-service
JWT_SECRET_KEY=changeme
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_REFRESH_TOKEN_COOKIE_SECURE=false

# file-service
MODUDRIVE_FILE_DEFAULT_QUOTA_BYTES=21474836480

# storage-service
STORAGE_MULTIPART_MAX_FILE_SIZE=25MB
STORAGE_MULTIPART_MAX_REQUEST_SIZE=25MB
MODUDRIVE_STORAGE_MAX_FILE_SIZE_BYTES=5368709120
STORAGE_BLOCK_SIZE=4194304
# base64-encoded AES-256 key; generate your own with `openssl rand -base64 32`
STORAGE_ENCRYPTION_KEY=changeme

# member-service
MEMBER_EMAIL_VERIFICATION_TOKEN_EXPIRATION=1800000

# mail-service (mail sending)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=changeme
MAIL_PASSWORD=changeme
MAIL_FROM=noreply@modudrive.com

# observability (Grafana admin login — anonymous viewer access is separate)
GRAFANA_ADMIN_PASSWORD=changeme
