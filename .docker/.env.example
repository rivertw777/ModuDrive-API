# Copy to .env and fill in real values for local dev.

# Postgres admin (infra only — services never use it)
POSTGRES_USER=modudrive
POSTGRES_PASSWORD=changeme
# One login per service database, created on an empty volume by .docker/postgres/
MEMBER_DB_PASSWORD=changeme
FILE_DB_PASSWORD=changeme
NOTIFICATION_DB_PASSWORD=changeme
AUTH_DB_PASSWORD=changeme

# Redis (auth, member, storage, mail-service)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# LocalStack token (app.localstack.cloud → Auth Tokens), also read by ./gradlew test
LOCALSTACK_AUTH_TOKEN=changeme

# SQS on LocalStack (member, auth, file, storage, mail, notification-service)
SQS_ENDPOINT=http://localstack:4566
SQS_REGION=ap-northeast-2
SQS_ACCESS_KEY=test
SQS_SECRET_KEY=test

# S3 on LocalStack (storage-service); PUBLIC_ENDPOINT is the address the browser PUTs blocks to
STORAGE_S3_ENDPOINT=http://localstack:4566
STORAGE_S3_PUBLIC_ENDPOINT=http://localhost:4566
STORAGE_S3_ACCESS_KEY=test
STORAGE_S3_SECRET_KEY=test
STORAGE_S3_BUCKET=modudrive
STORAGE_S3_REGION=ap-northeast-2

# Grafana admin login
GRAFANA_ADMIN_PASSWORD=changeme
DISCORD_SERVICE_WEBHOOK_URL=https://discord.com/api/webhooks/changeme
DISCORD_INFRA_WEBHOOK_URL=
DISCORD_MESSAGING_WEBHOOK_URL=

# Shared service config
SPRING_PROFILES_ACTIVE=dev

# Service ports
GATEWAY_SERVER_PORT=10001
MEMBER_SERVER_PORT=10010
AUTH_SERVER_PORT=10011
FILE_SERVER_PORT=10012
STORAGE_SERVER_PORT=10013
MAIL_SERVER_PORT=10014
NOTIFICATION_SERVER_PORT=10015

# gateway-service, mail-service
CLIENT_URL=http://localhost:3000

# file-service
MODUDRIVE_FILE_DEFAULT_QUOTA_BYTES=21474836480

# storage-service
STORAGE_BLOCK_SIZE=4194304
STORAGE_DOWNLOAD_QUOTA_PER_FILE_BYTES=10737418240
STORAGE_DOWNLOAD_QUOTA_WINDOW=PT24H

# mail-service: SES on LocalStack, sent mail readable at http://localhost:8025 (Mailpit)
SES_ENDPOINT=http://localstack:4566
MAIL_FROM=noreply@modudrive.com
