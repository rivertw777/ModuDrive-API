{
  "uid": "modudrive-messaging",
  "title": "ModuDrive · Messaging & Resilience",
  "description": "outbox·DLQ·서킷 — 알림이 울렸을 때 전후를 보는 곳",
  "tags": [
    "modudrive"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^(Prometheus|ModuDrive Prometheus)$/",
        "hide": 0
      },
      {
        "name": "logs",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "regex": "/^(Loki|grafanacloud-.*-logs)$/",
        "hide": 0
      },
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "refresh": 2,
        "query": {
          "query": "label_values(up{job=\"services\"}, service)",
          "refId": "svc"
        },
        "definition": "label_values(up{job=\"services\"}, service)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "비동기 이벤트 (005-messaging-spec)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "outbox 대기 시간 (가장 오래된 PENDING)",
      "description": "알림 OutboxLag: 120초 초과가 5분 (SQS 장애 등)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "max by (service, queue) (modudrive_outbox_lag_seconds{service=~\"$service\"})",
          "legendFormat": "{{service}} → {{queue}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "outbox FAILED 행",
      "description": "알림 OutboxFailed: 0보다 크면 바로. 사람이 처리해야 사라진다",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "max by (service, queue, reason) (modudrive_outbox_failed{service=~\"$service\"})",
          "legendFormat": "{{service}} → {{queue}} {{reason}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "DLQ 메시지",
      "description": "알림 DlqMessages: 0보다 크면 바로. DeadLetterReason 확인 후 리드라이브",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "max by (queue) (modudrive_dlq_messages)",
          "legendFormat": "{{queue}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "큐 대기 메시지",
      "description": "소비하는 큐에서 아직 안 받아 간 메시지 (처리 중·지연 제외). 줄지 않고 쌓이면 컨슈머가 느리거나 멈춘 것. AWS는 경보 queue-age-*가 가장 오래된 메시지 300초에서 울린다",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "max by (queue) (modudrive_queue_messages)",
          "legendFormat": "{{queue}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "서킷 브레이커 (006-resilience-spec)",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "서킷 상태",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "description": "열림·반열림은 요청이 와야 바뀐다. 알림은 아래 막은 호출로 본다",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "max by (service, name) (resilience4j_circuitbreaker_state{service=~\"$service\", state=\"open\"}) * 2 + max by (service, name) (resilience4j_circuitbreaker_state{service=~\"$service\", state=\"half_open\"})",
          "legendFormat": "{{service}} · {{name}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "green"
                },
                "1": {
                  "text": "half_open",
                  "color": "orange"
                },
                "2": {
                  "text": "open",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "timeseries",
      "title": "서킷이 막은 호출 (2분)",
      "description": "알림 CircuitOpen: 0보다 큰 상태가 2분. 열린 서킷이 사용자 요청을 막고 있다",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service, name) (increase(resilience4j_circuitbreaker_not_permitted_calls_total{service=~\"$service\"}[2m]))",
          "legendFormat": "{{service}} · {{name}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "서비스 간 호출 (Feign·WebClient)",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "호출 수",
      "description": "service가 부른 쪽, uri가 불린 API. gateway가 라우트로 넘긴 요청은 뺀다 (위 Overview 라우트 행)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service, uri) (rate(http_client_requests_seconds_count{service=~\"$service\", spring_cloud_gateway_route_id=\"\"}[5m]))",
          "legendFormat": "{{service}} → {{uri}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "실패 비율",
      "description": "5xx와 응답 없음(연결 실패·시간 초과, status=CLIENT_ERROR). 4xx는 하위 서비스가 정상으로 답한 것이라 뺀다",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service, uri) (rate(http_client_requests_seconds_count{service=~\"$service\", spring_cloud_gateway_route_id=\"\", status!~\"[1-4]..\"}[5m])) / sum by (service, uri) (rate(http_client_requests_seconds_count{service=~\"$service\", spring_cloud_gateway_route_id=\"\"}[5m]))",
          "legendFormat": "{{service}} → {{uri}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "x": 8,
        "y": 37,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "응답 시간 (평균)",
      "description": "길어지면 trace로 하위 서비스 안을 본다",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service, uri) (rate(http_client_requests_seconds_sum{service=~\"$service\", spring_cloud_gateway_route_id=\"\"}[5m])) / sum by (service, uri) (rate(http_client_requests_seconds_count{service=~\"$service\", spring_cloud_gateway_route_id=\"\"}[5m]))",
          "legendFormat": "{{service}} → {{uri}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12,
      "gridPos": {
        "x": 16,
        "y": 37,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "재시도 (5분)",
      "description": "successful_with_retry는 재시도로 살아난 호출, failed_with_retry는 재시도해도 실패한 호출. 늘면 하위 서비스가 흔들리는 중 — 서킷이 열리기 전 신호",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service, name, kind) (increase(resilience4j_retry_calls_total{service=~\"$service\", kind!=\"successful_without_retry\"}[5m])) > 0",
          "legendFormat": "{{service}} · {{name}} · {{kind}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "시간 초과 (5분)",
      "description": "TimeLimiter가 끊은 호출 (gateway 세션 확인 3초, 라우트 15초)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service, name) (increase(resilience4j_timelimiter_calls_total{service=~\"$service\", kind=\"timeout\"}[5m])) > 0",
          "legendFormat": "{{service}} · {{name}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 14,
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 8
      }
    }
  ],
  "editable": true
}
