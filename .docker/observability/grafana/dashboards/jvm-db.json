{
  "uid": "modudrive-jvm-db",
  "title": "ModuDrive · JVM & DB",
  "description": "서비스별 힙·GC·CPU와 DB 커넥션 풀",
  "tags": [
    "modudrive"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^(Prometheus|ModuDrive Prometheus)$/",
        "hide": 0
      },
      {
        "name": "logs",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "regex": "/^(Loki|grafanacloud-.*-logs)$/",
        "hide": 0
      },
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "refresh": 2,
        "query": {
          "query": "label_values(up{job=\"services\"}, service)",
          "refId": "svc"
        },
        "definition": "label_values(up{job=\"services\"}, service)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "JVM",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "힙 사용량",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service) (jvm_memory_used_bytes{service=~\"$service\", area=\"heap\"})",
          "legendFormat": "{{service}} used",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service) (jvm_memory_max_bytes{service=~\"$service\", area=\"heap\"})",
          "legendFormat": "{{service}} max",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "GC 뒤 old 영역 비율",
      "description": "알림 HeapHigh: 90% 초과가 5분. GC가 못 따라가 곧 OutOfMemoryError",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "max by (service) (jvm_gc_live_data_size_bytes{service=~\"$service\"}) / max by (service) (jvm_gc_max_data_size_bytes{service=~\"$service\"} > 0)",
          "legendFormat": "{{service}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "GC 멈춘 시간 (초당)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service) (rate(jvm_gc_pause_seconds_sum{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "CPU (프로세스)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "max by (service) (process_cpu_usage{service=~\"$service\"})",
          "legendFormat": "{{service}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "스레드",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "max by (service) (jvm_threads_live_threads{service=~\"$service\"})",
          "legendFormat": "{{service}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "DB 커넥션 (Hikari)",
      "id": 7,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "사용 중 / 최대",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service) (hikaricp_connections_active{service=~\"$service\"})",
          "legendFormat": "{{service}} active",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service) (hikaricp_connections_max{service=~\"$service\"})",
          "legendFormat": "{{service}} max",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "커넥션 대기 중인 스레드",
      "description": "0보다 크면 풀이 모자라기 시작한 것",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service) (hikaricp_connections_pending{service=~\"$service\"})",
          "legendFormat": "{{service}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "커넥션 못 받아 실패 (5분)",
      "description": "알림 DbPoolExhausted: 0보다 크면 바로",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service) (increase(hikaricp_connections_timeout_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "커넥션 받는 데 걸린 시간 (평균)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service) (rate(hikaricp_connections_acquire_seconds_sum{service=~\"$service\"}[5m])) / sum by (service) (rate(hikaricp_connections_acquire_seconds_count{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}",
          "exemplar": false,
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "커넥션 쥐고 있는 시간 (평균)",
      "description": "길어지면 트랜잭션 안에서 느린 일(외부 호출 등)을 하고 있는 것",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (service) (rate(hikaricp_connections_usage_seconds_sum{service=~\"$service\"}[5m])) / sum by (service) (rate(hikaricp_connections_usage_seconds_count{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}",
          "exemplar": false,
          "range": true,
          "instant": false,
