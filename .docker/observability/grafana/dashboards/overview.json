        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "메시징 이상",
      "description": "DLQ 메시지 + outbox FAILED 행 + 120초 넘게 밀린 outbox 큐. 알림 DlqMessages·OutboxFailed·OutboxLag",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "(sum(max by (queue) (modudrive_dlq_messages)) or vector(0)) + (sum(max by (service, queue, reason, detail) (modudrive_outbox_failed)) or vector(0)) + (count(max by (service, queue) (modudrive_outbox_lag_seconds) > 120) or vector(0))",
          "legendFormat": "__auto",
          "exemplar": false,
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Messaging & Resilience",
              "url": "/d/modudrive-messaging?${__url_time_range}"
            }
          ],
          "decimals": 0
