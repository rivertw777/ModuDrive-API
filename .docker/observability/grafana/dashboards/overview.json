      "title": "에러 로그 (trace_id를 누르면 trace)",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{service_name=~\"$service\"} | detected_level=\"error\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
