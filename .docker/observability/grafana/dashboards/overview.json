            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "(count(max by (service, instance) (jvm_gc_live_data_size_bytes) / max by (service, instance) (jvm_gc_max_data_size_bytes > 0) > 0.9) or vector(0)) + (count(max by (service) (increase(hikaricp_connections_timeout_total[5m])) > 0) or vector(0))",
          "legendFormat": "__auto",
          "exemplar": false,
