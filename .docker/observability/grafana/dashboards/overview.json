          },
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\", uri!~\"/actuator.*\", outcome=\"SERVER_ERROR\"}[5m])) / sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\", uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{service}}",
