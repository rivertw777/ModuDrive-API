{{/* Discord 메시지 — AWS(alertmanager.yaml → AMP)와 로컬(.docker/observability/alertmanager.yml)이 같이 쓴다.
     본문(discord.content) 아래에 제목만 있는 카드(discord.title)가 붙는다. */}}
{{ define "discord.target" }}{{ or .Labels.routeId .Labels.service }}{{ if .Labels.queue }} · `{{ .Labels.queue }}`{{ end }}{{ if .Labels.name }} · `{{ .Labels.name }}`{{ end }}{{ end }}
{{ define "discord.message" }}
{{- if eq (len .Alerts) 1 }}{{ range .Alerts }}
{{- if eq .Status "resolved" }}✅  **{{ .Annotations.title }} (해제)**

**대상**: {{ template "discord.target" . }}
{{- else }}🚨  **{{ .Annotations.title }}**

**대상**: {{ template "discord.target" . }}

**사유**: {{ .Annotations.summary }}

**조치**: {{ .Annotations.action }}
{{- if .Annotations.inspect }}

**확인 명령어**
```
{{ .Annotations.inspect }}
```
{{- end }}
{{- if .Annotations.redrive }}
**SQS 리드라이브 명령어**
```
{{ .Annotations.redrive }}
```
{{- end }}
{{- if .Annotations.logs }}

**relay 로그**
```
{{ .Annotations.logs }}
```
{{- end }}
{{- if .Annotations.query }}

**이벤트 조회 쿼리**
```sql
{{ .Annotations.query }}
```
{{- end }}
{{- if .Annotations.recovery }}
**이벤트 복구 쿼리**
```sql
{{ .Annotations.recovery }}
```
{{- end }}
{{- end }}
{{- end }}
{{- else }}
{{- if .Alerts.Firing }}🚨  **{{ .CommonAnnotations.title }}** ({{ len .Alerts.Firing }}건)
{{ range .Alerts.Firing }}
- {{ template "discord.target" . }} — {{ .Annotations.summary }}
{{- end }}

**조치**: {{ (index .Alerts.Firing 0).Annotations.action }}
{{ end }}
{{- if .Alerts.Resolved }}{{ if .Alerts.Firing }}
{{ end }}✅  **{{ .CommonAnnotations.title }} (해제)** ({{ len .Alerts.Resolved }}건)
{{ range .Alerts.Resolved }}
- {{ template "discord.target" . }}
{{- end }}
{{ end }}
{{- end }}
{{- end }}

{{/* 빈 줄 하나 뒤에 카드. 디스코드는 끝 줄바꿈을 지우므로 폭 없는 공백(U+200B)으로 붙잡는다. */}}
{{ define "discord.content" }}{{ template "discord.message" . }}{{ "\n\u200b" }}{{ end }}

{{ define "discord.title" }}
{{- if eq (len .Alerts) 1 }}{{ range .Alerts }}{{ .Annotations.title }}{{ if eq .Status "resolved" }} (해제){{ end }}{{ end }}
{{- else if .Alerts.Firing }}{{ .CommonAnnotations.title }} ({{ len .Alerts.Firing }}건)
{{- else }}{{ .CommonAnnotations.title }} (해제) ({{ len .Alerts.Resolved }}건)
{{- end }}
{{- end }}
